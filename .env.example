# Copy to .env and adjust.
PUID=1000
PGID=1000
TZ=Europe/Paris
# Host folder where episodes are saved (mounted as /downloads in the container)
DOWNLOAD_DIR=./downloads
# Comma-separated hostnames allowed to use the web UI besides localhost (LAN IP, Traefik domain)
ALLOWED_ORIGINS=192.168.1.20,crunchy.example.org
